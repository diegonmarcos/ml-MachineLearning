# n8n Model Orchestration Platform - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# REQUIRED: Change These Before Starting
# ============================================================================

# API Configuration - Generate with: openssl rand -hex 32
API_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_EXPIRY=3600

# Database Passwords - Choose secure passwords
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
TIMESCALEDB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_SECURE_PASSWORD
MINIO_ROOT_PASSWORD=CHANGE_ME_SECURE_PASSWORD
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_SECURE_PASSWORD
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# n8n Encryption Key - Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ============================================================================
# VPS Provider API Keys - Add at least ONE
# ============================================================================

# RunPod (Recommended - Easy to use)
# Get from: https://www.runpod.io/ → Settings → API Keys
RUNPOD_API_KEY=

# Vast.ai (Cheapest option)
# Get from: https://vast.ai/ → Account → API Keys
VAST_API_KEY=

# Lambda Labs (Most reliable)
# Get from: https://lambdalabs.com/ → API Keys
LAMBDA_API_KEY=

# Modal (Serverless)
# Get from: https://modal.com/ → Settings → Tokens
MODAL_TOKEN=

# TensorDock
# Get from: https://tensordock.com/ → API
TENSORDOCK_API_KEY=

# CoreWeave (Enterprise)
# Requires Kubernetes credentials
COREWEAVE_KUBECONFIG=

# ============================================================================
# Database Configuration (Leave defaults)
# ============================================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ml_platform
POSTGRES_USER=mluser

TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432
TIMESCALEDB_DB=metrics
TIMESCALEDB_USER=tsuser

REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# Object Storage - MinIO Configuration (Leave defaults)
# ============================================================================

MINIO_ROOT_USER=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=ml-platform
MINIO_USE_SSL=false

# ============================================================================
# n8n Configuration (Leave defaults)
# ============================================================================

N8N_HOST=n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_PROTOCOL=http
N8N_METRICS=true

# ============================================================================
# API Configuration (Leave defaults)
# ============================================================================

API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# ============================================================================
# Frontend Configuration (Leave defaults)
# ============================================================================

REACT_APP_API_URL=http://localhost:8000/v1
REACT_APP_WS_URL=ws://localhost:8000
REACT_APP_ENV=development

# ============================================================================
# Monitoring Configuration (Leave defaults)
# ============================================================================

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin

# ============================================================================
# OPTIONAL: Email Notifications
# ============================================================================

# SMTP Configuration (Gmail example)
# For Gmail: Enable "App Passwords" in your Google Account settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=ML Platform

# ============================================================================
# OPTIONAL: Slack Notifications
# ============================================================================

# Slack Webhook for cost alerts and job notifications
# Get from: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_CHANNEL=#ml-platform
# SLACK_USERNAME=ML Platform Bot

# ============================================================================
# OPTIONAL: Discord Notifications
# ============================================================================

# Discord Webhook
# Get from: Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# ============================================================================
# OPTIONAL: Advanced Configuration
# ============================================================================

# Environment
NODE_ENV=development
PYTHON_ENV=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_MINUTE=60

# Job Configuration
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_HOURS=24
DEFAULT_GPU_TYPE=A100
DEFAULT_GPU_COUNT=4

# Cost Management
DEFAULT_BUDGET_ALERT_THRESHOLD=0.80
COST_TRACKING_INTERVAL_SECONDS=30
ENABLE_COST_OPTIMIZATION=true

# Provider Selection
PROVIDER_SELECTION_STRATEGY=cost_optimized
ENABLE_SPOT_INSTANCES=true
ENABLE_AUTO_FAILOVER=true

# Storage
MAX_DATASET_SIZE_GB=100
MAX_MODEL_SIZE_GB=50
STORAGE_RETENTION_DAYS=30

# Cache
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE_MB=1024

# ============================================================================
# Production Overrides (uncomment for production deployment)
# ============================================================================

# API_RELOAD=false
# POSTGRES_HOST=your-rds-endpoint.amazonaws.com
# REDIS_HOST=your-elasticache-endpoint.amazonaws.com
# MINIO_ENDPOINT=your-s3-bucket.s3.amazonaws.com
# MINIO_USE_SSL=true
# N8N_PROTOCOL=https
# API_URL=https://api.yourdomain.com
# REACT_APP_API_URL=https://api.yourdomain.com/v1
# REACT_APP_WS_URL=wss://api.yourdomain.com
# LOG_LEVEL=warning
# CORS_ORIGINS=https://yourdomain.com
# RATE_LIMIT_PER_HOUR=5000

# ============================================================================
# Notes
# ============================================================================

# 1. Generate secure secrets:
#    openssl rand -hex 32
#
# 2. Minimum required providers: 1 (recommend RunPod or Vast.ai for testing)
#
# 3. Email is optional but recommended for job notifications
#
# 4. Slack/Discord optional for team notifications
#
# 5. For production, use managed services:
#    - AWS RDS for PostgreSQL
#    - AWS ElastiCache for Redis
#    - AWS S3 for MinIO (or keep MinIO)
#
# 6. Never commit .env file to git (already in .gitignore)
#
# 7. Review DEPLOYMENT.md for production configuration
